# LLM Provider Configuration
# Primary: Moonshot AI (Kimi)
MOONSHOT_API_KEY=your_moonshot_api_key_here
KIMI_API_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

# Alternative: OpenAI (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Application Settings
MAX_FILE_SIZE_MB=500

# Admin Page (/admin/llm) - HTTP Basic Auth
# Generate the hash:  python backend/scripts/hash_admin_password.py
# Single-quote the hash so $ characters are not interpreted by the shell.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$replace_with_output_of_hash_admin_password_script'

# Notes:
# - Once the LLM is configured via /admin/llm, settings are stored in
#   backend/config/llm_config.json (mode 600) and the values above for
#   MOONSHOT_API_KEY / OPENAI_API_KEY / KIMI_MODEL become first-boot fallbacks
#   only. To revert to env-only config, delete backend/config/llm_config.json.
