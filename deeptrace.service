[Unit]
Description=DeepTrace - PCAP Analyzer Backend
After=network.target

[Service]
Type=simple
User=sttp
Group=sttp
WorkingDirectory=/home/sttp/pcap/backend
Environment="PATH=/home/sttp/pcap/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
# nginx terminates :80 and proxies to 127.0.0.1:8000
ExecStart=/home/sttp/pcap/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
# uvicorn[standard] forks a worker subprocess that survives a plain SIGTERM
# to the parent, leaves it squatting on :8000, and blocks the next restart.
# KillMode=mixed: SIGTERM to MainPID, SIGKILL to every other process in the
# cgroup. TimeoutStopSec=15: give the worker 15s to exit before SIGKILL.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
